<Window x:Class="SenStrap.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SenStrap.UI"
        xmlns:controls="clr-namespace:SenStrap.UI.Controls"
        Title="SenStrap" Width="560" Height="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Icon="/SenStrap;component/Resources/senstrap.ico">

    <!-- The margin leaves room for the shadow -->
    <Grid x:Name="Frame" Margin="16">
        <Border CornerRadius="10" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid x:Name="Clipped" Margin="1" MouseLeftButtonDown="Window_MouseDown">
            <controls:Snowfall x:Name="Snow" Density="1.4" />

            <Grid Margin="30,24,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Image Source="/SenStrap;component/Resources/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="SenStrap" Margin="11,0,0,0" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <DockPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock x:Name="PercentText" DockPanel.Dock="Right" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Bottom" />
                    <TextBlock x:Name="StatusText" Text="{ui:Loc update.checking}" FontSize="15" Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                </DockPanel>

                <ProgressBar x:Name="Progress" Grid.Row="3" Style="{StaticResource SenProgress}" IsIndeterminate="True" />

                <DockPanel Grid.Row="4" Margin="0,14,0,0">
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                            Content="{ui:Loc boot.cancel}" Click="Cancel_Click" Margin="0,0,-10,0" />
                    <TextBlock FontSize="12" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"
                               Text="{ui:Loc update.hint}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
