<Window x:Class="SenStrap.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SenStrap.UI.Controls"
        Title="SenStrap" Width="880" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Icon="/SenStrap;component/Resources/senstrap.ico">

    <!-- The margin leaves room for the shadow -->
    <Grid Margin="16">
        <Border CornerRadius="10" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid x:Name="Clipped" Margin="1" MouseLeftButtonDown="Window_MouseDown">
            <controls:Snowfall x:Name="Snow" />

            <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="Close_Click" />

            <Grid Margin="36,30,36,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="4,0,0,22">
                    <Image Source="/SenStrap;component/Resources/logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="SubtitleText" FontSize="13.5" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <UniformGrid x:Name="LanguageGrid" Columns="4" VerticalAlignment="Top" />
                </ScrollViewer>

                <Button x:Name="ContinueButton" Grid.Row="2" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        Margin="0,18,4,0" Padding="22,9" Click="Continue_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ContinueText" />
                        <TextBlock Text="&#xE76C;" Style="{StaticResource BtnIcon}" Margin="10,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
