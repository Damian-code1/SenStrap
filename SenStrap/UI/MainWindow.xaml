<Window x:Class="SenStrap.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SenStrap.UI"
        xmlns:controls="clr-namespace:SenStrap.UI.Controls"
        Title="SenStrap" Width="1160" Height="760" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" Icon="/SenStrap;component/Resources/senstrap.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <controls:Snowfall x:Name="Snow" />

        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,14,12,14">
                    <Image DockPanel.Dock="Top" Source="/SenStrap;component/Resources/logo-texto.png" Height="32"
                           HorizontalAlignment="Left" Margin="10,6,0,20" RenderOptions.BitmapScalingMode="HighQuality"
                           WindowChrome.IsHitTestVisibleInChrome="False" />

                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="SidebarPlay" Style="{StaticResource PlayButton}" HorizontalAlignment="Stretch" Padding="0,11"
                                Click="SidebarPlay_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource BtnIcon}" FontSize="14" Margin="0,0,10,0" />
                                <TextBlock Text="{ui:Loc nav.play}" />
                            </StackPanel>
                        </Button>
                        <DockPanel Margin="4,12,4,0">
                            <TextBlock x:Name="RobloxLabel" DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource SubtleBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="120" />
                            <TextBlock x:Name="VersionLabel" FontSize="11.5" Foreground="{StaticResource SubtleBrush}" />
                        </DockPanel>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavPanel">
                            <TextBlock Text="{ui:Loc nav.groupPlay}" Style="{StaticResource NavGroup}" Margin="12,0,0,6" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{ui:Loc nav.home}" CommandParameter="Home" Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="{ui:Loc nav.history}" CommandParameter="History" Checked="Nav_Checked" />

                            <TextBlock Text="{ui:Loc nav.groupRoblox}" Style="{StaticResource NavGroup}" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE768;" Content="{ui:Loc nav.launcher}" CommandParameter="Launcher" Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7C1;" Content="{ui:Loc nav.flags}" CommandParameter="Flags" Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE909;" Content="{ui:Loc nav.globalSettings}" CommandParameter="GlobalSettings" Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7FC;" Content="{ui:Loc nav.robloxSettings}" CommandParameter="GameSettings" Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="{ui:Loc nav.mods}" CommandParameter="Mods" Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE71B;" Content="{ui:Loc nav.integrations}" CommandParameter="Integrations" Checked="Nav_Checked" />

                            <TextBlock Text="{ui:Loc nav.groupPc}" Style="{StaticResource NavGroup}" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE945;" Content="{ui:Loc nav.optimizations}" CommandParameter="Optimizations" Checked="Nav_Checked" />

                            <TextBlock Text="{ui:Loc nav.groupApp}" Style="{StaticResource NavGroup}" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE790;" Content="{ui:Loc nav.appearance}" CommandParameter="Appearance" Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{ui:Loc nav.settings}" CommandParameter="Settings" Checked="Nav_Checked" />
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE77B;" Content="{ui:Loc nav.credits}" CommandParameter="Credits" Checked="Nav_Checked" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click" />
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="Close_Click" />
                </StackPanel>

                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />

                <!-- Unsaved changes (only while there are some) -->
                <Border x:Name="DirtyBar" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                        Padding="18,9,9,9" CornerRadius="8" Background="#1B1229" BorderBrush="#3F2E5C" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{ui:Loc common.unsaved}" Margin="10,0,24,0" FontSize="13" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostButton}" Content="{ui:Loc common.discard}" Click="Discard_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{ui:Loc common.save}" Margin="6,0,0,0" Padding="16,7" Click="Save_Click" />
                    </StackPanel>
                </Border>

                <!-- Toast -->
                <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,76"
                        Padding="14,9" CornerRadius="6" Background="#1B1229" BorderBrush="#3A2B54"
                        BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastText" Margin="9,0,0,0" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Intro: the logo appears over the snow, then the window shows up -->
        <Grid x:Name="Intro" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="Intro_MouseDown">
            <StackPanel x:Name="IntroMark" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
                <Image Source="/SenStrap;component/Resources/logo.png" Width="76" Height="76" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="SenStrap" Margin="0,16,0,0" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" />
                <Border Width="132" Height="2" Margin="0,18,0,0" CornerRadius="1" Background="#2B1F42">
                    <Border x:Name="IntroBar" Width="0" HorizontalAlignment="Left" CornerRadius="1" Background="{StaticResource AccentBrush}" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
