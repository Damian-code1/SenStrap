<Window x:Class="SenStrap.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SenStrap.UI"
        xmlns:controls="clr-namespace:SenStrap.UI.Controls"
        Title="SenStrap" Width="1140" Height="740" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" Icon="/SenStrap;component/Resources/senstrap.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <controls:AnimatedBackground x:Name="Backdrop" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="/SenStrap;component/Resources/logo.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="SenStrap" Margin="10,0,0,0" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="PageCrumb" Margin="8,0,0,0" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>

            <!-- Cuerpo -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Menú lateral -->
                <DockPanel x:Name="Sidebar" Margin="14,6,10,16">
                    <Image DockPanel.Dock="Top" Source="/SenStrap;component/Resources/logo-texto.png" Height="40"
                           HorizontalAlignment="Left" Margin="8,4,0,22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="VersionLabel" DockPanel.Dock="Bottom" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                    <StackPanel x:Name="NavPanel">
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="{ui:Loc nav.home}" CommandParameter="Home" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE768;" Content="{ui:Loc nav.launcher}" CommandParameter="Launcher" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE71B;" Content="{ui:Loc nav.integrations}" CommandParameter="Integrations" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="{ui:Loc nav.history}" CommandParameter="History" Checked="Nav_Checked" />
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="12,8" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7C1;" Content="{ui:Loc nav.flags}" CommandParameter="Flags" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="{ui:Loc nav.mods}" CommandParameter="Mods" Checked="Nav_Checked" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE790;" Content="{ui:Loc nav.appearance}" CommandParameter="Appearance" Checked="Nav_Checked" />
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="12,8" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="{ui:Loc nav.settings}" CommandParameter="Settings" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>

                <!-- Contenido -->
                <Border x:Name="ContentPanel" Grid.Column="1" Margin="0,0,14,14" CornerRadius="16" Background="{StaticResource PanelBrush}"
                        BorderThickness="1">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <LinearGradientBrush.RelativeTransform>
                                <RotateTransform CenterX="0.5" CenterY="0.5" />
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Offset="0" Color="#66FFB547" />
                            <GradientStop Offset="0.3" Color="#1AFFFFFF" />
                            <GradientStop Offset="0.7" Color="#1AFFFFFF" />
                            <GradientStop Offset="1" Color="#66FF2E7A" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentControl x:Name="PageHost" Focusable="False" />

                        <!-- Barra inferior -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="22,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Click="SaveAndPlay_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource BtnIcon}" />
                                            <TextBlock Text="{ui:Loc common.saveplay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Content="{ui:Loc common.save}" Margin="10,0,0,0" Click="Save_Click" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="{ui:Loc common.close}" Margin="10,0,0,0" Click="Close_Click" />
                                </StackPanel>
                                <StackPanel x:Name="DirtyHint" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Ellipse x:Name="DirtyDot" Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{ui:Loc common.unsaved}" Margin="8,0,0,0" FontSize="12.5"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Aviso flotante -->
                        <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                                Padding="16,10" CornerRadius="12" Background="#F21A1D3D" BorderBrush="#33FFFFFF"
                                BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
