<ui:ShellPage x:Class="SenStrap.UI.Pages.HistoryPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:SenStrap.UI">
    <Grid Margin="32,6,32,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Click="Clear_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource BtnIcon}" />
                    <TextBlock Text="{ui:Loc history.clear}" />
                </StackPanel>
            </Button>
            <TextBlock Text="{ui:Loc history.title}" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <DockPanel Grid.Row="1">
            <Border x:Name="TotalChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Top" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource AccentSolidBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TotalText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="{ui:Loc history.subtitle}" Style="{StaticResource PageSubtitle}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <!-- Sin partidas -->
            <Border x:Name="EmptyState" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="26,30">
                <StackPanel HorizontalAlignment="Center">
                    <Border Style="{StaticResource IconBox}" Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource IconGlyph}" FontSize="24" />
                    </Border>
                    <TextBlock Text="{ui:Loc history.empty}" Style="{StaticResource CardDesc}" TextAlignment="Center"
                               MaxWidth="420" Margin="0,14,0,0" FontSize="13.5" />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GameList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel x:Name="ListPanel" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="60" Height="60">
                                        <Border CornerRadius="12" Background="{StaticResource AccentTintBrush}">
                                            <TextBlock Text="&#xE7FC;" Style="{StaticResource IconGlyph}" FontSize="22" />
                                        </Border>
                                        <Border CornerRadius="12">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="15.5" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource CardDesc}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                            Tag="{Binding Entry}" Click="Rejoin_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource BtnIcon}" />
                                            <TextBlock Text="{ui:Loc history.rejoin}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:ShellPage>
