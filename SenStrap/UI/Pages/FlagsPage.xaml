<ui:ShellPage x:Class="SenStrap.UI.Pages.FlagsPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:SenStrap.UI"
              xmlns:controls="clr-namespace:SenStrap.UI.Controls">
    <Grid Margin="32,26,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Text="{ui:Loc flags.title}" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Text="{ui:Loc flags.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

        <!-- Pestañas + interruptor general -->
        <DockPanel Grid.Row="2" Margin="0,0,0,14">
            <CheckBox x:Name="ManageToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center"
                      Content="{ui:Loc flags.manage}" FontSize="13" Click="Manage_Click" />
            <Border HorizontalAlignment="Left" CornerRadius="11" Background="#80080A18" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="3">
                <Grid>
                    <Border x:Name="SegmentPill" CornerRadius="8" Background="{StaticResource AccentHorizontalBrush}" HorizontalAlignment="Left">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF5B3A" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                    </Border>
                    <UniformGrid x:Name="SegmentGrid" Columns="2">
                        <RadioButton x:Name="PresetsTab" Style="{StaticResource Segment}" GroupName="FlagsTabs" IsChecked="True" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource BtnIcon}" FontSize="13" />
                                <TextBlock Text="{ui:Loc flags.tabPresets}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="EditorTab" Style="{StaticResource Segment}" GroupName="FlagsTabs" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE943;" Style="{StaticResource BtnIcon}" FontSize="13" />
                                <TextBlock Text="{ui:Loc flags.tabEditor}" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Grid>
            </Border>
        </DockPanel>

        <Grid x:Name="Body" Grid.Row="3">

            <!-- ============ Ajustes rápidos ============ -->
            <ScrollViewer x:Name="PresetsView" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PresetsPanel" Margin="0,0,4,8">
                    <controls:SettingRow Icon="&#xE771;" Title="{ui:Loc flags.msaa}" Description="{ui:Loc flags.msaaDesc}">
                        <ComboBox x:Name="MsaaCombo" Style="{StaticResource Combo}" SelectionChanged="Preset_Changed">
                            <ComboBoxItem Content="{ui:Loc common.default}" Tag="" />
                            <ComboBoxItem Content="1x" Tag="1" />
                            <ComboBoxItem Content="2x" Tag="2" />
                            <ComboBoxItem Content="4x" Tag="4" />
                            <ComboBoxItem Content="8x" Tag="8" />
                        </ComboBox>
                    </controls:SettingRow>
                    <controls:SettingRow Icon="&#xE706;" Title="{ui:Loc flags.voxel}" Description="{ui:Loc flags.voxelDesc}">
                        <CheckBox x:Name="VoxelToggle" Style="{StaticResource Toggle}" Click="Preset_Changed" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="&#xE753;" Title="{ui:Loc flags.graySky}" Description="{ui:Loc flags.graySkyDesc}">
                        <CheckBox x:Name="GraySkyToggle" Style="{StaticResource Toggle}" Click="Preset_Changed" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="&#xE790;" Title="{ui:Loc flags.grass}" Description="{ui:Loc flags.grassDesc}">
                        <CheckBox x:Name="GrassToggle" Style="{StaticResource Toggle}" Click="Preset_Changed" />
                    </controls:SettingRow>
                    <controls:SettingRow x:Name="MeshRow" Icon="&#xE8F1;" Title="{ui:Loc flags.mesh}" Description="{ui:Loc flags.meshDesc}" Margin="0,0,0,0">
                        <CheckBox x:Name="MeshToggle" Style="{StaticResource Toggle}" Click="Preset_Changed" />
                    </controls:SettingRow>
                    <Border x:Name="MeshPanel" Style="{StaticResource Card}" Margin="26,4,0,8" Padding="20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{ui:Loc flags.performance}" Style="{StaticResource CardDesc}" VerticalAlignment="Center" />
                            <Slider x:Name="MeshSlider" Grid.Column="1" Style="{StaticResource SenSlider}" Minimum="0" Maximum="250"
                                    Value="125" Margin="16,0" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="MeshSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" Text="{ui:Loc flags.quality}" Style="{StaticResource CardDesc}" VerticalAlignment="Center" />
                            <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="14,0,0,0" MinWidth="52">
                                <TextBlock x:Name="MeshValue" FontSize="12" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <controls:SettingRow Icon="&#xE770;" Title="{ui:Loc flags.dpi}" Description="{ui:Loc flags.dpiDesc}">
                        <CheckBox x:Name="DpiToggle" Style="{StaticResource Toggle}" Click="Preset_Changed" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="&#xE7F4;" Title="{ui:Loc flags.renderer}" Description="{ui:Loc flags.rendererDesc}">
                        <ComboBox x:Name="RendererCombo" Style="{StaticResource Combo}" MinWidth="210" SelectionChanged="Preset_Changed">
                            <ComboBoxItem Content="{ui:Loc flags.d3d11}" Tag="d3d11" />
                            <ComboBoxItem Content="Vulkan" Tag="vulkan" />
                            <ComboBoxItem Content="OpenGL" Tag="opengl" />
                        </ComboBox>
                    </controls:SettingRow>
                    <controls:SettingRow Icon="&#xE740;" Title="{ui:Loc flags.altEnter}" Description="{ui:Loc flags.altEnterDesc}">
                        <CheckBox x:Name="AltEnterToggle" Style="{StaticResource Toggle}" Click="Preset_Changed" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="&#xE734;" Title="{ui:Loc flags.level}" Description="{ui:Loc flags.levelDesc}">
                        <ComboBox x:Name="QualityCombo" Style="{StaticResource Combo}" MaxDropDownHeight="320" SelectionChanged="Preset_Changed" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="&#xE8B9;" Title="{ui:Loc flags.texture}" Description="{ui:Loc flags.textureDesc}">
                        <ComboBox x:Name="TextureCombo" Style="{StaticResource Combo}" SelectionChanged="Preset_Changed" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="&#xE7A7;" Title="{ui:Loc flags.reset}" Description="{ui:Loc flags.resetDesc}">
                        <Button Style="{StaticResource DangerButton}" Content="{ui:Loc flags.resetButton}" Click="Reset_Click" />
                    </controls:SettingRow>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Editor ============ -->
            <Grid x:Name="EditorView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource WarnCard}" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{StaticResource WarnBrush}" />
                        <TextBlock Text="{ui:Loc flags.allowlist}" Margin="10,0,0,0" FontSize="12.5" Foreground="#FFE3A8"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Barra de herramientas -->
                <DockPanel Grid.Row="1" Margin="0,0,0,10">
                    <WrapPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ShowAdd_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource BtnIcon}" />
                                <TextBlock Text="{ui:Loc flags.add}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Import_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource BtnIcon}" />
                                <TextBlock Text="{ui:Loc flags.import}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Export_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;" Style="{StaticResource BtnIcon}" />
                                <TextBlock Text="{ui:Loc flags.export}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Copy_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource BtnIcon}" />
                                <TextBlock Text="{ui:Loc flags.copy}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="DeleteAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource BtnIcon}" />
                                <TextBlock Text="{ui:Loc flags.deleteAll}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>

                <!-- Añadir flag -->
                <Border x:Name="AddPanel" Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewName" Style="{StaticResource Input}" Tag="{ui:Loc flags.name}"
                                 FontFamily="Cascadia Mono, Consolas" KeyDown="AddInput_KeyDown" />
                        <TextBox x:Name="NewValue" Grid.Column="1" Style="{StaticResource Input}" Tag="{ui:Loc flags.value}"
                                 Margin="10,0,0,0" FontFamily="Cascadia Mono, Consolas" KeyDown="AddInput_KeyDown" />
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Add_Click">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="CancelAdd_Click">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Cabecera de la tabla -->
                <DockPanel Grid.Row="3" Margin="0,0,10,8">
                    <TextBlock x:Name="TotalText" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <CheckBox x:Name="ShowPresetsToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True"
                              Content="{ui:Loc flags.showPresets}" FontSize="12" Margin="0,0,18,0" Click="ShowPresets_Click" />
                    <Grid HorizontalAlignment="Left" Width="280">
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Tag="{ui:Loc flags.search}" Padding="34,0,10,0"
                                 TextChanged="Search_Changed" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource SubtleBrush}"
                                   VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>

                <!-- Tabla -->
                <Border Grid.Row="4" CornerRadius="12" Background="#66080A18" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="6">
                    <Grid>
                        <TextBlock x:Name="EmptyText" Text="{ui:Loc flags.empty}" Style="{StaticResource CardDesc}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13.5" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FlagList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="9" Background="Transparent" Padding="8,5" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="210" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeBrush}" ToolTip="{Binding BadgeTip}"
                                                           FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Name}" />
                                                <TextBox Grid.Column="2" Style="{StaticResource Input}" Height="32" FontSize="12.5"
                                                         FontFamily="Cascadia Mono, Consolas"
                                                         Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="6,0,0,0"
                                                        Tag="{Binding}" Click="DeleteFlag_Click" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Perfiles -->
                <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource IconGlyph}" FontSize="15" />
                            <TextBlock Text="{ui:Loc flags.profiles}" Style="{StaticResource CardTitle}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <ComboBox x:Name="ProfileCombo" Style="{StaticResource Combo}" MinWidth="160" Height="34" Margin="0,0,6,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{ui:Loc flags.profileLoad}" Margin="0,0,6,0" Click="LoadProfile_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="{ui:Loc flags.profileDelete}" Margin="0,0,14,0" Click="DeleteProfile_Click" />
                            <TextBox x:Name="ProfileName" Style="{StaticResource Input}" Tag="{ui:Loc flags.profileName}" Width="160" Height="34" Margin="0,0,6,0" />
                            <Button Style="{StaticResource SecondaryButton}" Click="SaveProfile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource BtnIcon}" />
                                    <TextBlock Text="{ui:Loc flags.profileSave}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:ShellPage>
