<ui:ShellPage x:Class="SenStrap.UI.Pages.GameSettingsPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:SenStrap.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,6,32,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Margin="0,6,0,0"
                        Click="Reset_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource BtnIcon}" />
                        <TextBlock Text="{ui:Loc rs.reset}" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{ui:Loc rs.title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{ui:Loc rs.subtitle}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>
            <Border x:Name="MissingCard" Style="{StaticResource WarnCard}" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock Text="{ui:Loc rs.missing}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
            </Border>
            <StackPanel x:Name="List" />
        </StackPanel>
    </ScrollViewer>
</ui:ShellPage>
