<ui:ShellPage x:Class="SenStrap.UI.Pages.HomePage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:SenStrap.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Margin="32,6,32,24">
            <TextBlock x:Name="Greeting" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="StatusLine" Style="{StaticResource PageSubtitle}" Margin="0,4,0,18" />

            <!-- Install -->
            <Border x:Name="InstallCard" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBox}">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{ui:Loc home.notInstalled}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{ui:Loc home.installDesc}" Style="{StaticResource CardDesc}" Margin="0,3,0,10" />
                        <CheckBox x:Name="DesktopShortcut" Style="{StaticResource Toggle}" IsChecked="True"
                                  Content="{ui:Loc home.desktopShortcut}" FontSize="13" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="Install_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource BtnIcon}" />
                            <TextBlock Text="{ui:Loc home.install}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Banner: last game (or ready to play) -->
            <Grid Height="236">
                <Border CornerRadius="10" Background="#171925" />
                <Border CornerRadius="10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush x:Name="HeroImage" Stretch="UniformToFill" AlignmentY="Center" />
                    </Border.Background>
                </Border>
                <!-- Darkens the left side so the text stays readable over any thumbnail -->
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FA101119" />
                            <GradientStop Offset="0.5" Color="#C0101119" />
                            <GradientStop Offset="1" Color="#30101119" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Image x:Name="HeroLogo" Source="/SenStrap;component/Resources/logo.png" Width="120" Height="120"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,48,0" Opacity="0.9"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,24" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock x:Name="HeroLabel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                               Foreground="White" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeroDetails" FontSize="13" Foreground="#C9CBD6" Margin="0,4,0,16" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="HeroRejoin" Style="{StaticResource PrimaryButton}" Padding="18,9" Click="Rejoin_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource BtnIcon}" />
                                <TextBlock Text="{ui:Loc history.rejoin}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HeroPlay" Style="{StaticResource SecondaryButton}" Padding="18,9" Margin="8,0,0,0" Click="Play_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource BtnIcon}" />
                                <TextBlock Text="{ui:Loc home.openRoblox}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Stats -->
            <UniformGrid Columns="4" Margin="0,14,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc home.statPlaytime}" Style="{StaticResource CardDesc}" />
                        <TextBlock x:Name="StatPlaytime" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc home.statGames}" Style="{StaticResource CardDesc}" />
                        <TextBlock x:Name="StatGames" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource CardAction}" Margin="3,0,3,0" Click="Flags_Click">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc home.statFlags}" Style="{StaticResource CardDesc}" />
                        <TextBlock x:Name="StatFlags" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardAction}" Margin="5,0,0,0" Click="Optimizations_Click">
                    <StackPanel>
                        <TextBlock Text="{ui:Loc home.statOptimizations}" Style="{StaticResource CardDesc}" />
                        <TextBlock x:Name="StatOptimizations" Style="{StaticResource StatValue}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Recent games -->
            <DockPanel x:Name="RecentHeader" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{ui:Loc home.seeAll}" VerticalAlignment="Bottom"
                        Margin="0,0,-10,4" Click="History_Click" />
                <TextBlock Text="{ui:Loc home.recent}" Style="{StaticResource SectionTitle}" />
            </DockPanel>
            <UniformGrid x:Name="RecentGrid" Columns="3" />
        </StackPanel>
    </ScrollViewer>
</ui:ShellPage>
