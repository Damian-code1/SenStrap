<ui:ShellPage x:Class="SenStrap.UI.Pages.HomePage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:SenStrap.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Margin="32,26,32,20">

            <!-- Tarjeta principal -->
            <Border x:Name="Hero" Style="{StaticResource HeroCard}" Padding="26,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="108" Height="108">
                        <Ellipse x:Name="Halo" Width="190" Height="190" Margin="-41" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#88FF5B3A" />
                                    <GradientStop Offset="0.45" Color="#33FF2E7A" />
                                    <GradientStop Offset="1" Color="#00FF2E7A" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image x:Name="Logo" Source="/SenStrap;component/Resources/logo.png" Width="108" Height="108"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="26,0,20,0" VerticalAlignment="Center">
                        <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextBrush}">
                            <Run Text="Sen" Foreground="{StaticResource AccentHorizontalBrush}" /><Run Text="Strap" />
                        </TextBlock>
                        <TextBlock Text="{ui:Loc home.tagline}" FontSize="14.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,14" />
                        <WrapPanel x:Name="Chips">
                            <Border Style="{StaticResource Chip}">
                                <TextBlock x:Name="RobloxChip" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock x:Name="FlagsChip" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock x:Name="ModsChip" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                            <Border x:Name="PlaytimeChipBorder" Style="{StaticResource Chip}">
                                <TextBlock x:Name="PlaytimeChip" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource PlayButton}" VerticalAlignment="Center" Click="Play_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource BtnIcon}" FontSize="18" Margin="0,0,12,0" />
                            <TextBlock Text="{ui:Loc home.play}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Instalar -->
            <Border x:Name="InstallCard" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBox}" Width="46" Height="46">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyph}" FontSize="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{ui:Loc home.notInstalled}" Style="{StaticResource CardTitle}" FontSize="15.5" />
                        <TextBlock Text="{ui:Loc home.installDesc}" Style="{StaticResource CardDesc}" Margin="0,3,0,10" />
                        <CheckBox x:Name="DesktopShortcut" Style="{StaticResource Toggle}" IsChecked="True"
                                  Content="{ui:Loc home.desktopShortcut}" FontSize="13" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="Install_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource BtnIcon}" />
                            <TextBlock Text="{ui:Loc home.install}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Última partida -->
            <Border x:Name="LastGameCard" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="54" Height="54">
                        <Border CornerRadius="12" Background="{StaticResource AccentTintBrush}">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource IconGlyph}" FontSize="20" />
                        </Border>
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush x:Name="LastGameIcon" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{ui:Loc home.lastGame}" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                        <TextBlock x:Name="LastGameName" Style="{StaticResource CardTitle}" FontSize="15.5" Margin="0,1,0,1" />
                        <TextBlock x:Name="LastGameDetails" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="Rejoin_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource BtnIcon}" />
                            <TextBlock Text="{ui:Loc history.rejoin}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Text="{ui:Loc home.quick}" Style="{StaticResource SectionTitle}" />
            <UniformGrid Columns="3">
                <Button Style="{StaticResource CardAction}" Margin="0,0,6,0" Click="Mods_Click">
                    <StackPanel>
                        <Border Style="{StaticResource IconBox}" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource IconGlyph}" />
                        </Border>
                        <TextBlock Text="{ui:Loc nav.mods}" Style="{StaticResource CardTitle}" Margin="0,12,0,2" />
                        <TextBlock Text="{ui:Loc home.quickMods}" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardAction}" Margin="3,0,3,0" Click="Flags_Click">
                    <StackPanel>
                        <Border Style="{StaticResource IconBox}" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE7C1;" Style="{StaticResource IconGlyph}" />
                        </Border>
                        <TextBlock Text="{ui:Loc nav.flags}" Style="{StaticResource CardTitle}" Margin="0,12,0,2" />
                        <TextBlock Text="{ui:Loc home.quickFlags}" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardAction}" Margin="6,0,0,0" Click="History_Click">
                    <StackPanel>
                        <Border Style="{StaticResource IconBox}" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource IconGlyph}" />
                        </Border>
                        <TextBlock Text="{ui:Loc nav.history}" Style="{StaticResource CardTitle}" Margin="0,12,0,2" />
                        <TextBlock Text="{ui:Loc home.quickHistory}" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,11">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{StaticResource OkBrush}" />
                    <TextBlock Text="{ui:Loc home.safe}" Style="{StaticResource CardDesc}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ui:ShellPage>
