<ui:ShellPage x:Class="SenStrap.UI.Pages.OptimizationsPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:SenStrap.UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Margin="32,26,32,0">
            <TextBlock Text="{ui:Loc opt.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{ui:Loc opt.subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />
        </StackPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="32,0,32,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RecommendedButton" Style="{StaticResource PrimaryButton}" Padding="14,7" Click="Recommended_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource BtnIcon}" />
                        <TextBlock Text="{ui:Loc opt.applyRecommended}" />
                    </StackPanel>
                </Button>
                <Button x:Name="RevertAllButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RevertAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource BtnIcon}" />
                        <TextBlock Text="{ui:Loc opt.revertAll}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Width="210" Tag="{ui:Loc opt.search}" TextChanged="Filter_Changed" />
                <ComboBox x:Name="CategoryCombo" Style="{StaticResource Combo}" MinWidth="160" Margin="8,0,0,0" SelectionChanged="Filter_Changed" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,4,28,80">
                    <TextBlock x:Name="SummaryText" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="2,0,0,10" />
                    <!-- Shown after changes that need Explorer or the PC to restart -->
                    <Border x:Name="NoticeCard" Style="{StaticResource WarnCard}" Margin="0,0,0,10" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="RestartExplorerButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                    Content="{ui:Loc opt.restartExplorer}" Padding="12,5" Margin="12,0,0,0" Click="RestartExplorer_Click" />
                            <TextBlock x:Name="NoticeText" FontSize="12.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="List" />
                    <TextBlock x:Name="EmptyText" Text="{ui:Loc opt.noResults}" Style="{StaticResource CardDesc}" Margin="2,12,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Pending changes -->
            <Border x:Name="PendingBar" VerticalAlignment="Bottom" Margin="32,0,32,16" Padding="16,10" CornerRadius="8"
                    Background="#1E2130" BorderBrush="#3A3F55" BorderThickness="1" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="DiscardButton" Style="{StaticResource GhostButton}" Content="{ui:Loc opt.discard}" Click="Discard_Click" />
                        <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="6,0,0,0" Click="Apply_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ApplyShield" Text="&#xEA18;" Style="{StaticResource BtnIcon}" Visibility="Collapsed" />
                                <TextBlock Text="{ui:Loc opt.apply}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="PendingText" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:ShellPage>
