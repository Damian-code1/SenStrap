<ui:ShellPage x:Class="SenStrap.UI.Pages.SettingsPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:SenStrap.UI"
              xmlns:controls="clr-namespace:SenStrap.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Margin="32,6,32,24">
            <TextBlock Text="{ui:Loc settings.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{ui:Loc settings.subtitle}" Style="{StaticResource PageSubtitle}" />

            <TextBlock Text="{ui:Loc settings.general}" Style="{StaticResource SectionTitle}" Margin="2,0,0,10" />
            <controls:SettingRow Icon="&#xE774;" Title="{ui:Loc settings.language}" Description="{ui:Loc settings.languageDesc}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RestartButton" Style="{StaticResource PrimaryButton}" Content="{ui:Loc settings.restart}"
                            Margin="0,0,10,0" Visibility="Collapsed" Click="Restart_Click" />
                    <ComboBox x:Name="LanguageCombo" Style="{StaticResource Combo}" MinWidth="210" MaxDropDownHeight="360"
                              SelectionChanged="Language_Changed" />
                </StackPanel>
            </controls:SettingRow>

            <controls:SettingRow Icon="&#xE895;" Title="{ui:Loc settings.autoUpdate}" Description="{ui:Loc settings.autoUpdateDesc}">
                <CheckBox x:Name="AutoUpdateToggle" Style="{StaticResource Toggle}" Click="AutoUpdate_Click" />
            </controls:SettingRow>

            <TextBlock Text="{ui:Loc settings.roblox}" Style="{StaticResource SectionTitle}" />
            <controls:SettingRow Icon="&#xE72C;" Title="{ui:Loc settings.reinstall}" Description="{ui:Loc settings.reinstallDesc}">
                <Button Style="{StaticResource SecondaryButton}" Content="{ui:Loc settings.reinstallButton}" Click="Reinstall_Click" />
            </controls:SettingRow>
            <controls:SettingRow x:Name="FolderRow" Icon="&#xE8B7;" Title="{ui:Loc settings.folder}">
                <Button Style="{StaticResource SecondaryButton}" Content="{ui:Loc common.open}" Click="OpenFolder_Click" />
            </controls:SettingRow>
            <controls:SettingRow Icon="&#xE8A5;" Title="{ui:Loc settings.logs}" Description="{ui:Loc settings.logsDesc}">
                <Button Style="{StaticResource SecondaryButton}" Content="{ui:Loc common.open}" Click="OpenLogs_Click" />
            </controls:SettingRow>

            <TextBlock Text="{ui:Loc settings.app}" Style="{StaticResource SectionTitle}" />
            <controls:SettingRow Icon="&#xE74D;" Title="{ui:Loc settings.uninstall}" Description="{ui:Loc settings.uninstallDesc}">
                <Button Style="{StaticResource DangerButton}" Content="{ui:Loc settings.uninstallButton}" Click="Uninstall_Click" />
            </controls:SettingRow>

            <Border x:Name="About" Style="{StaticResource HeroCard}" Margin="0,16,0,0" Padding="22,18">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/SenStrap;component/Resources/logo.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AboutTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{ui:Loc settings.about}" Style="{StaticResource CardDesc}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ui:ShellPage>
